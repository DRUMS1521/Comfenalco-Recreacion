# Base de datos
DATABASE_URL=sqlite:///./comfenalco.db
# Para producción con PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/comfenalco

# JWT
SECRET_KEY=tu_clave_secreta_muy_segura_aqui_cambiar_en_produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
EMAIL_FROM=tu_email@gmail.com
EMAIL_RECREACION=recreacion@comfenalcotolima.com

# App
APP_NAME=Comfenalco Tolima - Servicios de Recreación
FRONTEND_URL=http://localhost:5173

# Integración Argus (viáticos).
# ARGUS_PDATOS es obligatorio: identifica al empleado (formato empresa-empleado).
# ARGUS_COOKIE es OPCIONAL: se verificó que Argus devuelve exactamente lo mismo con
# cookie válido, inválido o ausente, así que su caducidad no rompe la consulta.
ARGUS_COOKIE=
ARGUS_PDATOS=

# Sembrado inicial de usuarios (solo si la tabla de usuarios está vacía).
# Si se define, todos los usuarios sembrados usan esta contraseña; si se deja
# vacía se genera una aleatoria que aparece una sola vez en el log del arranque.
# Ya no hay contraseñas por defecto en el código.
SEED_PASSWORD_DEFAULT=

# Ocultar por defecto las solicitudes clasificadas como administrativas
# (ruido de la migración del cronograma) en calendarios, listados y estadísticas.
EXCLUIR_ADMINISTRATIVAS_POR_DEFECTO=true
